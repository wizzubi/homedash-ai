# ─────────────────────────────────────────────────────────────
# HomeDash AI — zmienne środowiskowe (kopiuj do .env / .env.local)
# ─────────────────────────────────────────────────────────────

# BAZA DANYCH · libSQL / SQLite
# ── Produkcja: Turso (zalecane) ──────────────────────────────
# TURSO_DATABASE_URL=libsql://twoja-baza-twoja-org.turso.io
# TURSO_AUTH_TOKEN=twoj_token_bazy
#
# ── Lokalnie: pojedynczy plik SQLite ─────────────────────────
DATABASE_URL=file:./data/homedash.db

# Alternatywnie możesz podać adres Turso bezpośrednio w DATABASE_URL:
# DATABASE_URL=libsql://twoja-baza-twoja-org.turso.io

# ASYSTENT AI · dostawcy modeli (opcjonalne, AI Fallback w ostateczności)
# Bez kluczy aplikacja działa dalej: polecenia głosowe (zadania, godziny,
# notatki, odpady) są obsługiwane lokalnie, a swobodna rozmowa jest wyłączona.
# ── OpenRouter (główny) ─────────────────────────────────────────
# Wiele kluczy: rotacja Round-Robin + automatyczny fallback przy 429/401.
# Klucze oddziel przecinkami (dozwolone też średniki i nowe linie):
# OPENROUTER_API_KEYS="klucz1,klucz2,klucz3"
# Pojedynczy klucz (wsteczna kompatybilność) też działa i łączy się z listą.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# ── Groq (zapasowy, gdy OpenRouter niedostępny) ─────────────────
# Załóż klucz na https://console.groq.com, model musi wspierać Tool Calling,
# np. openai/gpt-oss-120b.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Kolejność prób dostawców (domyślnie: openrouter,groq)
# AI_PROVIDER_ORDER=openrouter,groq

# PANEL ADMINISTRATORA (opcjonalne)
# Jeżeli ustawisz ADMIN_PIN, ma on pierwszeństwo przed PIN-em z bazy danych.
ADMIN_PIN=

# Asystent OpenAI przez OpenRouter (używany w nagłówkach HTTP-Referer / X-Title)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
